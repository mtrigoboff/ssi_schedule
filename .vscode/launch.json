{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "current python file",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal"
		},
		{
			"name": "no args",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/schedule_formatter.py",
			"console": "integratedTerminal"
		},
		{
			"name": "csv 2026",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/schedule_formatter.py",
			"console": "integratedTerminal",
			"args": [
				"-csv", "2026 Fall Class Schedule.csv"
			]
		},
		{
			"name": "tsv 2026",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/schedule_formatter.py",
			"console": "integratedTerminal",
			"args": [
				"-tsv", "2026 Fall Class Schedule.tsv"
			]
		},
		{
			"name": "csv",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/schedule_formatter.py",
			"console": "integratedTerminal",
			"args": [
				"-csv", "${command:pickArgs}"
			]
		},
		{
			"name": "docx",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/schedule_formatter.py",
			"console": "integratedTerminal",
			"args": [
				"-docx", "${command:pickArgs}"
			]
		},
		{
			"name": "enter args",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/schedule_formatter.py",
			"console": "integratedTerminal",
			"args": [
				"${command:pickArgs}"
			]
		}
	]
}